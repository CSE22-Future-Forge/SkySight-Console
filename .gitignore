# Virtual environment
.venv/
venv/
env/

# Python caches
__pycache__/
*.py[cod]
*.egg-info/

# Runtime operator data (person database, thumbnails, exports)
data/
*_db/
# ...but not the phone app's data-layer source, which "data/" would otherwise swallow.
!mobile_app/src/data/

# Scratch / test artifacts
.pytest_cache/
_u_*
_test_db/
*.log
kernel.errors.txt

# Generated OpenVINO/ONNX exports (not loaded at runtime; regenerate with
# `python -m fusion_model.export_openvino`)
fusion_model/export/

# Large sample media (exceeds GitHub's 100 MB file limit; use Git LFS if needed)
*.mp4
*.avi
*.mov
*.mkv
*.webm

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# PyInstaller / installer output
build/
dist/

# Offline map archives (built by tools/build_map.sh into %LOCALAPPDATA%/SARManifest/maps)
*.pmtiles
