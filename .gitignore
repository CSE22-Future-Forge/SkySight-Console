*.mp4
*.avi
*.mov
*.mkv
*.webm

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# PyInstaller / installer output
build/
dist/

# Offline map archives (built by tools/build_map.sh into %LOCALAPPDATA%/SARManifest/maps)
*.pmtiles
